{
  "name": "webbilling-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "token-server": "node server/index.js",
    "dev-fake-https": "vite --config vite-https.config.ts",
    "build": "tsc && vite build",
    "lint": "oxlint --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "(vite &) && sleep 5 && playwright test",
    "test:ui": "(vite &) && sleep 5 && playwright test --ui",
    "test:e2e": "playwright test",
    "test:e2e-ui": "playwright test --ui",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@revenuecat/purchases-js": "link:../..",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.12.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.6.0",
    "axios": "^1.20.0",
    "dotenv": "^16.4.7",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.56.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-plugin-mkcert": "^1.17.8",
    "vitest": "^4.1.12"
  }
}
