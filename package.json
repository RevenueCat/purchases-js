{
  "name": "@revenuecat/purchases-js",
  "version": "1.79.0",
  "private": false,
  "description": "Web subscriptions made easy. Powered by RevenueCat",
  "keywords": [
    "iap",
    "purchases",
    "revenuecat",
    "subscriptions"
  ],
  "bugs": {
    "url": "https://github.com/RevenueCat/purchases-js/issues"
  },
  "license": "MIT",
  "author": "RevenueCat, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RevenueCat/purchases-js.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/Purchases.umd.js",
  "module": "./dist/Purchases.es.js",
  "types": "./dist/Purchases.es.d.ts",
  "exports": {
    ".": {
      "import": "./dist/Purchases.es.js",
      "require": "./dist/Purchases.umd.js"
    },
    "./styles": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "scripts": {
    "watch": "vite build --config vite.watch.config.js --watch",
    "build": "tsc && vite build && pnpm run build:vega",
    "build:dev": "tsc && vite build --mode development && pnpm --filter @revenuecat/purchases-js-vega build --mode development",
    "build:dev-watch": "tsc && vite build --mode development --config vite.watch.config.js --watch",
    "preview": "vite preview",
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "pack-build": "npm run build && npm pack",
    "test": "vitest run",
    "verify:entry-point-boundaries": "node scripts/verify-entry-point-boundaries.mjs",
    "test:watch": "vitest watch",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "svelte-check": "svelte-check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "extract-api": "api-extractor run --local --verbose && api-extractor run --local --verbose --config vega/api-extractor.json",
    "check-version-consistency": "node scripts/check-version-consistency.mjs",
    "build:vega": "pnpm --filter @revenuecat/purchases-js-vega build"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.48.0",
    "@paddle/paddle-js": "^1.6.4",
    "@payrails/web-sdk": "^6.11.0",
    "@revenuecat/esconfig": "0.4.0",
    "@revenuecat/purchases-ui-js": "4.20.1",
    "@storybook/addon-docs": "^9.1.21",
    "@storybook/addon-links": "^9.1.21",
    "@storybook/addon-svelte-csf": "^5.0.6",
    "@storybook/svelte": "^9.1.21",
    "@storybook/svelte-vite": "9.1.21",
    "@storybook/sveltekit": "^9.1.21",
    "@stripe/stripe-js": "^9.7.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.6",
    "@types/node": "^22.10.5",
    "chromatic": "^18.14.5",
    "eslint-plugin-svelte": "^3.24.1",
    "http-status-codes": "^2.3.0",
    "jsdom": "^25.0.1",
    "lefthook": "^2.2.2",
    "msw": "^2.0.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "storybook": "^9.1.21",
    "storybook-addon-mock-date": "^1.0.2",
    "storybook-addon-pseudo-states": "^9.1.21",
    "svelte": "^5.46.4",
    "svelte-check": "^4.1.1",
    "typedoc": "^0.27.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.15.0"
}
