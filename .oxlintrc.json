{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["node_modules/@revenuecat/esconfig/.oxlintrc.json"],
  "jsPlugins": ["eslint-plugin-svelte"],
  "env": {
    "browser": true
  },
  "ignorePatterns": ["examples/", "api-report/", "docs/", "fastlane/"],
  "rules": {
    // Type aliases/Records in the public API change the published .d.ts and remove declaration merging
    "typescript/consistent-indexed-object-style": "off",
    "typescript/consistent-type-definitions": "off",
    // `_` prefixes are the convention for private members and unused parameters
    "no-underscore-dangle": "off",

    "class-methods-use-this": "warn", // TODO: change to error
    "default-param-last": "warn", // TODO: change to error
    "func-style": "warn", // TODO: change to error
    "import/extensions": "warn", // TODO: change to error
    "import/no-default-export": "warn", // TODO: change to error
    "import/no-duplicates": "warn", // TODO: change to error
    "import/no-unassigned-import": "warn", // TODO: change to error
    "no-await-in-loop": "warn", // TODO: change to error
    "no-empty-function": "warn", // TODO: change to error
    "no-new": "warn", // TODO: change to error
    "no-shadow": "warn", // TODO: change to error
    "no-unneeded-ternary": "warn", // TODO: change to error
    "no-use-before-define": "warn", // TODO: change to error
    "object-shorthand": "warn", // TODO: change to error
    "oxc/no-async-endpoint-handlers": "warn", // TODO: change to error
    "typescript/await-thenable": "warn", // TODO: change to error
    "typescript/consistent-return": "warn", // TODO: change to error
    "typescript/no-confusing-void-expression": "warn", // TODO: change to error
    "typescript/no-deprecated": "warn", // TODO: change to error
    "typescript/no-dynamic-delete": "warn", // TODO: change to error
    "typescript/no-extraneous-class": "warn", // TODO: change to error
    "typescript/no-floating-promises": "warn", // TODO: change to error
    "typescript/no-inferrable-types": "warn", // TODO: change to error
    "typescript/no-invalid-void-type": "warn", // TODO: change to error
    "typescript/no-misused-promises": "warn", // TODO: change to error
    "typescript/no-misused-spread": "warn", // TODO: change to error
    "typescript/no-non-null-assertion": "warn", // TODO: change to error
    "typescript/no-redundant-type-constituents": "warn", // TODO: change to error
    "typescript/no-unnecessary-condition": "warn", // TODO: change to error
    "typescript/no-unnecessary-type-assertion": "warn", // TODO: change to error
    "typescript/no-unnecessary-type-parameters": "warn", // TODO: change to error
    "typescript/no-unsafe-argument": "warn", // TODO: change to error
    "typescript/no-unsafe-assignment": "warn", // TODO: change to error
    "typescript/no-unsafe-call": "warn", // TODO: change to error
    "typescript/no-unsafe-enum-assignment": "warn", // TODO: change to error
    "typescript/no-unsafe-enum-comparison": "warn", // TODO: change to error
    "typescript/no-unsafe-member-access": "warn", // TODO: change to error
    "typescript/no-unsafe-return": "warn", // TODO: change to error
    "typescript/no-unsafe-type-assertion": "warn", // TODO: change to error
    "typescript/non-nullable-type-assertion-style": "warn", // TODO: change to error
    "typescript/only-throw-error": "warn", // TODO: change to error
    "typescript/prefer-nullish-coalescing": "warn", // TODO: change to error
    "typescript/prefer-optional-chain": "warn", // TODO: change to error
    "typescript/prefer-promise-reject-errors": "warn", // TODO: change to error
    "typescript/restrict-template-expressions": "warn", // TODO: change to error
    "typescript/return-await": "warn", // TODO: change to error
    "typescript/strict-boolean-expressions": "warn", // TODO: change to error
    "typescript/switch-exhaustiveness-check": "warn", // TODO: change to error
    "typescript/unbound-method": "warn", // TODO: change to error
    "typescript/use-unknown-in-catch-callback-variable": "warn", // TODO: change to error
    "unicorn/consistent-function-scoping": "warn", // TODO: change to error
    "unicorn/no-array-sort": "warn", // TODO: change to error
    "unicorn/no-empty-file": "warn", // TODO: change to error

    "no-restricted-globals": [
      "error",
      {
        "name": "window",
        "message": "Use getWindow() or getNullableWindow() from helpers/browser-globals instead."
      },
      {
        "name": "document",
        "message": "Use getDocument() or getNullableDocument() from helpers/browser-globals instead."
      }
    ],
    "svelte/comment-directive": "error",
    "svelte/infinite-reactive-loop": "error",
    "svelte/no-at-debug-tags": "warn",
    "svelte/no-dom-manipulating": "error",
    "svelte/no-dupe-else-if-blocks": "error",
    "svelte/no-dupe-on-directives": "error",
    "svelte/no-dupe-style-properties": "error",
    "svelte/no-dupe-use-directives": "error",
    "svelte/no-immutable-reactive-statements": "error",
    "svelte/no-inner-declarations": "error",
    "svelte/no-inspect": "warn",
    "svelte/no-not-function-handler": "error",
    "svelte/no-object-in-text-mustaches": "error",
    "svelte/no-raw-special-elements": "error",
    "svelte/no-reactive-functions": "error",
    "svelte/no-reactive-literals": "error",
    "svelte/no-reactive-reassign": "error",
    "svelte/no-shorthand-style-property-overrides": "error",
    "svelte/no-store-async": "error",
    "svelte/no-svelte-internal": "error",
    "svelte/no-unknown-style-directive-property": "error",
    "svelte/no-unnecessary-state-wrap": "error",
    "svelte/no-unused-props": "error",
    "svelte/no-unused-svelte-ignore": "error",
    "svelte/no-useless-children-snippet": "error",
    "svelte/no-useless-mustaches": "error",
    "svelte/prefer-svelte-reactivity": "error",
    "svelte/prefer-writable-derived": "error",
    "svelte/require-each-key": "error",
    "svelte/require-event-dispatcher-types": "error",
    "svelte/require-store-reactive-access": "error",
    "svelte/system": "error",
    "svelte/valid-each-key": "error"
  },
  "overrides": [
    {
      "files": ["**/*.svelte"],
      "rules": {
        "no-inner-declarations": "off",
        "no-self-assign": "off"
      }
    },
    {
      "files": ["src/stories/**"],
      "rules": {
        "typescript/ban-ts-comment": "off",
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "**/*.test.{js,ts}",
        "**/tests/**/*.{js,ts}",
        "vitest.setup.js",
        ".storybook/**",
        "scripts/**"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": [
        "scripts/**",
        "*.config.{js,ts}",
        "vitest.setup.js",
        ".storybook/**"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
